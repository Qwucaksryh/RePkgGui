<ui:FluentWindow x:Class="RePkgGui.Views.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="设置"
                 Width="620"
                 Height="604"
                 MinWidth="520"
                 MinHeight="480"
                 ResizeMode="CanResizeWithGrip"
                 WindowStartupLocation="CenterOwner"
                 ShowInTaskbar="False"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 ExtendsContentIntoTitleBar="True"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 FontFamily="Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="设置"
                     ShowMinimize="False"
                     ShowMaximize="False"
                     ShowClose="True" />

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Padding="24,2,24,0"
                      ClipToBounds="True">
            <StackPanel>

                <!-- ============ 外观 ============ -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="外观"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Width="76"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <RadioButton x:Name="ThemeSystem" Content="跟随系统" GroupName="Theme" Margin="0,0,24,0" />
                    <RadioButton x:Name="ThemeLight" Content="浅色" GroupName="Theme" Margin="0,0,24,0" />
                    <RadioButton x:Name="ThemeDark" Content="深色" GroupName="Theme" />
                </StackPanel>

                <Border Style="{StaticResource SectionDivider}" />

                <!-- ============ 输出 ============ -->
                <TextBlock Text="输出" Style="{StaticResource SectionHeader}" />

                <TextBlock Text="默认输出目录" Style="{StaticResource FieldLabel}" />
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:TextBox x:Name="OutputBox"
                                Grid.Column="0"
                                Height="36"
                                VerticalContentAlignment="Center"
                                PlaceholderText="例如：C:\Users\Public\Desktop" />

                    <ui:Button Grid.Column="1"
                               Height="36"
                               MinWidth="76"
                               Margin="8,0,0,0"
                               Content="浏览"
                               Click="Browse_Click" />
                </Grid>

                <CheckBox x:Name="OpenWhenDoneCheck" Content="提取完成后自动打开输出目录" />

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="已有同名文件时"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0">
                        <RadioButton x:Name="OverwriteRadio" Content="覆盖" GroupName="Overwrite" Margin="0,0,24,0" />
                        <RadioButton x:Name="SkipRadio" Content="跳过，保留已有文件" GroupName="Overwrite" />
                    </StackPanel>
                </Grid>

                <CheckBox x:Name="FlatOutputCheck"
                          Content="忽略包内目录结构，所有文件放在同一层"
                          Margin="0,16,0,0"
                          ToolTip="开启后不再创建 materials / video 等子目录，同名文件会自动加 _2、_3。" />

                <Border Style="{StaticResource SectionDivider}" />

                <!-- ============ 提取内容 ============ -->
                <TextBlock Text="提取内容" Style="{StaticResource SectionHeader}" />

                <CheckBox x:Name="NoTexConvertCheck"
                          Content="不转换 TEX，.tex 原样导出（只解包）"
                          Checked="NoTexConvert_Changed"
                          Unchecked="NoTexConvert_Changed">
                    <CheckBox.ToolTip>
                        <ToolTip MaxWidth="380">
                            <TextBlock TextWrapping="Wrap"
                                       LineHeight="20"
                                       FontSize="12"
                                       Text="TEX 是 Wallpaper Engine 自己的贴图容器：把压缩像素、mipmap 和动图帧打在一个文件里，类似“游戏专用的图片包”，在资源管理器里双击打不开。&#x0a;&#x0a;勾选：.tex 原样导出，不解码。解包更快、不多占空间，但这些文件需要 RePKG 之类的工具才能查看。&#x0a;&#x0a;不勾选：自动把 .tex 转成 .png / .gif / .mp4（默认）。" />
                        </ToolTip>
                    </CheckBox.ToolTip>
                </CheckBox>

                <CheckBox x:Name="KeepRawTexCheck"
                          Content="转换的同时保留原始 .tex 文件"
                          Margin="0,8,0,0" />
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <CheckBox x:Name="MediaOnlyCheck"
                              Content="仅保留图片和视频"
                              VerticalAlignment="Center"
                              ToolTip="只导出 png / jpg / gif / webp / mp4 / webm 等媒体文件，json、bin、字体等一律忽略。" />

                    <ui:TextBox Grid.Column="1"
                                x:Name="SkipExtensionsBox"
                                Height="32"
                                Margin="16,0,0,0"
                                VerticalContentAlignment="Center"
                                PlaceholderText="额外忽略的扩展名，如 .json, .bin" />
                </Grid>




            </StackPanel>
        </ScrollViewer>

        <ui:InfoBar Grid.Row="2"
                    x:Name="ErrorBar"
                    Margin="24,10,24,0"
                    IsOpen="False"
                    Severity="Error"
                    Title="无法保存"
                    IsClosable="False" />

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="24,14,24,18">
            <ui:Button Content="取消" MinWidth="88" Click="Cancel_Click" />
            <ui:Button Content="保存"
                       MinWidth="88"
                       Margin="8,0,0,0"
                       Appearance="Primary"
                       Click="Save_Click" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
