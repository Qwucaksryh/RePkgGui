<ui:FluentWindow x:Class="RePkgGui.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:models="clr-namespace:RePkgGui.Models"
                 Title="RePKG 提取工具"
                 Width="820"
                 Height="800"
                 MinWidth="700"
                 MinHeight="600"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 ExtendsContentIntoTitleBar="True"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 FontFamily="Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI"
                 UseLayoutRounding="True"
                 TextOptions.TextFormattingMode="Display"
                 AllowDrop="True"
                 DragEnter="Window_DragOver"
                 DragOver="Window_DragOver"
                 DragLeave="Window_DragLeave"
                 Drop="Window_Drop">

    <ui:FluentWindow.Resources>
        <ContextMenu x:Key="PickerMenu">
            <MenuItem Header="选择文件（PKG / MPKG / TEX）" Click="PickFile_Click" />
            <MenuItem Header="选择文件夹" Click="PickFolder_Click" />
        </ContextMenu>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============ 1. 顶部栏 ============ -->
        <Grid Grid.Row="0">
            <ui:TitleBar Height="32"
                         Title=""
                         ShowMinimize="True"
                         ShowMaximize="True"
                         ShowClose="True">

                <ui:TitleBar.Header>
                    <!--
                        WPF-UI 的窗口按钮（— □ ×）是 30px 高、**贴顶**布局（中心 15），
                        TitleBar 默认高 48 会让居中的左侧内容低 8px。
                        这里把 TitleBar 定为 32，左侧内容也用 30 高 + 贴顶，两边几何模型完全一致。
                    -->
                    <Grid Height="30" Margin="-25,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Box24"
                                       FontSize="15"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                        <TextBlock Text="RePKG 提取工具"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="9,0,14,0"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                        <ui:Button Width="28" Height="28" Padding="0"
                                   Appearance="Transparent"
                                   BorderBrush="Transparent"
                                   Background="Transparent"
                                   ToolTip="设置"
                                   Click="Settings_Click">
                            <ui:SymbolIcon Symbol="Settings20" FontSize="15" />
                        </ui:Button>
                        <ui:Button Width="28" Height="28" Padding="0" Margin="2,0,0,0"
                                   Appearance="Transparent"
                                   BorderBrush="Transparent"
                                   Background="Transparent"
                                   ToolTip="关于"
                                   Click="About_Click">
                            <ui:SymbolIcon Symbol="Info20" FontSize="15" />
                        </ui:Button>
                    </StackPanel>
                    </Grid>
                </ui:TitleBar.Header>

                <ui:TitleBar.TrailingContent>
                    <ui:Button Width="32" Height="30" Padding="0" Margin="0,0,2,0"
                               VerticalAlignment="Top"
                               Appearance="Transparent"
                               BorderBrush="Transparent"
                               Background="Transparent"
                               ToolTip="{Binding ThemeTooltip}"
                               Command="{Binding CycleThemeCommand}">
                        <ui:SymbolIcon Symbol="{Binding ThemeSymbol}" FontSize="15" />
                    </ui:Button>
                </ui:TitleBar.TrailingContent>
            </ui:TitleBar>

            <Border VerticalAlignment="Bottom"
                    Height="1"
                    Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
        </Grid>

        <!-- ============ 2. 主体 ============ -->
        <Grid Grid.Row="1" Margin="32,10,32,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 拖拽 / 点击区（180x180，保持正方形） -->
            <Grid x:Name="DropZone"
                  Grid.Row="0"
                  Width="168"
                  Height="168"
                  HorizontalAlignment="Center"
                  Background="Transparent"
                  Cursor="Hand"
                  MouseLeftButtonUp="DropZone_Click">

                <Border CornerRadius="16">
                    <Border.Style>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="2" Direction="270"
                                          Opacity="0.14" Color="#000000" />
                    </Border.Effect>
                </Border>

                <!-- 拖入时的高亮覆盖层 -->
                <Border x:Name="DragOverlay"
                        CornerRadius="16"
                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                        Opacity="0.12"
                        Visibility="Collapsed"
                        IsHitTestVisible="False" />

                <Rectangle x:Name="DashRect"
                           Margin="0.75"
                           RadiusX="15.5"
                           RadiusY="15.5"
                           StrokeThickness="1.5"
                           StrokeDashArray="4 3"
                           IsHitTestVisible="False">
                    <Rectangle.Style>
                        <Style TargetType="{x:Type Rectangle}">
                            <Setter Property="Stroke" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Stroke" Value="{DynamicResource ControlStrokeColorSecondaryBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Rectangle.Style>
                </Rectangle>

                <!-- 空状态 -->
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisibility}}">
                    <ui:SymbolIcon Symbol="BoxArrowUp24"
                                   FontSize="30"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="拖拽到此或点击选择"
                               Margin="0,10,0,0"
                               HorizontalAlignment="Center"
                               FontSize="12.5"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="PKG · MPKG · TEX"
                               Margin="0,4,0,0"
                               HorizontalAlignment="Center"
                               FontSize="11"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>

                <!-- 已选择状态 -->
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                    <ui:SymbolIcon Symbol="{Binding SelectionIcon}"
                                   FontSize="26"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock Text="{Binding SelectionTitle}"
                               Margin="0,8,0,0"
                               MaxWidth="146"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               ToolTip="{Binding InputPath}"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="{Binding SelectionDetail}"
                               Margin="0,3,0,0"
                               MaxWidth="146"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               FontSize="11"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </Grid>

            <!-- 输入路径 -->
            <Grid Grid.Row="1" Margin="0,16,0,8">
                <TextBlock Text="输入路径"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <ui:HyperlinkButton Content="支持范围 ⓘ"
                                    HorizontalAlignment="Right"
                                    FontSize="11"
                                    Padding="0"
                                    Click="ShowFormats_Click">
                    <ui:HyperlinkButton.ToolTip>
                        <ToolTip MaxWidth="420">
                            <StackPanel>
                                <TextBlock Text="可识别的输入" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <TextBlock TextWrapping="Wrap" LineHeight="19"
                                           Text="• .pkg / .mpkg —— Wallpaper Engine 资源包，解包后按包名建子文件夹&#x0a;• .tex —— Wallpaper Engine 贴图容器，直接转成图片&#x0a;• 文件夹 —— 递归查找其中的 PKG / MPKG" />
                                <TextBlock Text="TEX 内部格式" FontWeight="SemiBold" Margin="0,10,0,6" />
                                <TextBlock TextWrapping="Wrap" LineHeight="19"
                                           Text="• 未压缩：RGBA8888、R8、RG88 → PNG&#x0a;• 压缩：DXT1 / DXT3 / DXT5 → 解压后 PNG&#x0a;• 动图贴图 → GIF&#x0a;• 视频贴图 → MP4&#x0a;• 包内其它文件（mp4 / webm / json / bin…）原样导出" />
                            </StackPanel>
                        </ToolTip>
                    </ui:HyperlinkButton.ToolTip>
                </ui:HyperlinkButton>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:TextBox Grid.Column="0"
                            Height="38"
                            VerticalContentAlignment="Center"
                            PlaceholderText="输入或粘贴 PKG / MPKG / TEX 文件，或包含它们的文件夹路径"
                            ClearButtonEnabled="True"
                            Text="{Binding InputPath, UpdateSourceTrigger=PropertyChanged}" />

                <ui:Button Grid.Column="1"
                           Height="38"
                           MinWidth="84"
                           Margin="8,0,0,0"
                           ToolTip="从剪贴板读取路径"
                           Command="{Binding PasteCommand}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ClipboardPaste20" FontSize="14" Margin="0,0,6,0" />
                        <TextBlock Text="粘贴" VerticalAlignment="Center" />
                    </StackPanel>
                </ui:Button>
            </Grid>

            <!-- 输出目录 -->
            <Grid Grid.Row="3" Margin="0,14,0,8">
                <TextBlock Text="输出目录"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <ui:HyperlinkButton Content="在资源管理器中打开 ↗"
                                    HorizontalAlignment="Right"
                                    FontSize="11"
                                    Padding="0"
                                    ToolTip="直接打开上面这个目录；要换目录点右侧「浏览」"
                                    Command="{Binding OpenOutputDirectoryCommand}" />
            </Grid>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:TextBox Grid.Column="0"
                            Height="38"
                            VerticalContentAlignment="Center"
                            PlaceholderText="输出目录（默认桌面）"
                            ClearButtonEnabled="True"
                            Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}" />

                <ui:Button Grid.Column="1"
                           Height="38"
                           MinWidth="84"
                           Margin="8,0,0,0"
                           ToolTip="选择其他文件夹作为输出目录"
                           Click="BrowseOutput_Click">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Folder20" FontSize="14" Margin="0,0,6,0" />
                        <TextBlock Text="浏览" VerticalAlignment="Center" />
                    </StackPanel>
                </ui:Button>
            </Grid>

            <!-- 开始提取 -->
            <ui:Button Grid.Row="5"
                       Height="44"
                       Margin="0,16,0,0"
                       HorizontalAlignment="Stretch"
                       HorizontalContentAlignment="Center"
                       Appearance="{Binding StartAppearance}"
                       IsEnabled="{Binding IsStartEnabled}"
                       Command="{Binding StartOrCancelCommand}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <ui:SymbolIcon Symbol="{Binding StartIcon}" FontSize="16" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding StartButtonText}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </ui:Button>

            <!-- 进度 -->
            <Grid Grid.Row="6" Margin="0,12,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding StatusText}"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="1"
                               Margin="12,0,0,0"
                               Text="{Binding ProgressText}"
                               FontSize="11"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Grid>

                <ProgressBar Grid.Row="1"
                             Style="{StaticResource FluentProgressBar}"
                             Maximum="100"
                             Value="{Binding ProgressValue}" />
            </Grid>

            <!-- InfoBar -->
            <ui:InfoBar Grid.Row="7"
                        Margin="0,10,0,0"
                        IsOpen="{Binding IsInfoBarOpen}"
                        Severity="{Binding InfoSeverity}"
                        Title="{Binding InfoTitle}"
                        Message="{Binding InfoMessage}"
                        IsClosable="True" />
        </Grid>

        <!-- ============ 3. 日志 ============ -->
        <Border Grid.Row="2"
                Margin="32,0,32,18"
                MinHeight="110"
                CornerRadius="10"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="14,8,8,2">
                    <TextBlock Text="日志"
                               FontSize="11"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:HyperlinkButton Content="打开输出目录"
                                            FontSize="11"
                                            Padding="6,2"
                                            Click="OpenOutput_Click" />
                        <ui:HyperlinkButton Content="清空"
                                            FontSize="11"
                                            Padding="6,2"
                                            Command="{Binding ClearLogCommand}" />
                    </StackPanel>
                </Grid>

                <ListBox x:Name="LogList"
                         Grid.Row="1"
                         Margin="8,0,8,8"
                         ItemsSource="{Binding Logs}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="{x:Type ListBoxItem}">
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="IsHitTestVisible" Value="False" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:LogEntry}">
                            <Grid Margin="6,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{Binding TimeText}"
                                           FontFamily="Cascadia Mono, Consolas"
                                           FontSize="10.5"
                                           Margin="0,1,8,0"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                                <TextBlock Grid.Column="1"
                                           Text="{Binding Text}"
                                           FontSize="11.5"
                                           TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Level}" Value="Success">
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="Warning">
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="Error">
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 空状态提示 -->
                <TextBlock Grid.Row="1"
                           Text="暂无日志，选择文件后点击「开始提取」"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="12"
                           IsHitTestVisible="False"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Logs.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <!-- Snackbar 提示层 -->
        <ui:SnackbarPresenter x:Name="SnackbarHost"
                              Grid.Row="2"
                              VerticalAlignment="Bottom"
                              HorizontalAlignment="Center"
                              Margin="0,0,0,16" />
    </Grid>
</ui:FluentWindow>
